    },
    {
      "start": 90.72,
      "end": 94.72,
      "text": "I held up the glass like a holy little toast",
      "uncertain": false
    },
    {
      "start": 94.72,
      "end": 96.56,
      "text": "Said you could have a sip",
      "uncertain": false
    },
    {
