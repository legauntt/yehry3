      "end": 29.8,
      "text": "I say trouble sounds fine",
      "uncertain": false
    },
    {
      "start": 29.8,
      "end": 33.58,
      "text": "Then my waiter brings the water and I freeze at the side",
      "uncertain": false
    },
    {
      "start": 33.58,
      "end": 37.52,
      "text": "There's a rule in my religion that can wreck a perfect night",
      "uncertain": false
    },
    {
      "start": 37.52,
      "end": 42.54,
      "text": "I tried to play casual, tried to chase the subject fast",
