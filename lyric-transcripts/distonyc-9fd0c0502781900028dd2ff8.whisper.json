    },
    {
      "start": 20.78,
      "end": 23.02,
      "text": "I was lucky to become",
      "uncertain": false
    },
    {
      "start": 23.02,
      "end": 25.68,
      "text": "We rented half a duplex",
      "uncertain": false
    },
    {
      "start": 25.68,
