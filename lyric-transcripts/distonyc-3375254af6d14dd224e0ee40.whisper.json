  "segments": [
    {
      "start": 7.3,
      "end": 10.28,
      "text": "My mother kept the Friday candles low",
      "uncertain": true
    },
    {
      "start": 10.28,
      "end": 13.1,
      "text": "And named the hills her grandmother knew",
      "uncertain": true
    },
    {
      "start": 13.86,
      "end": 16.94,
      "text": "My father folded maps beside the window",
      "uncertain": false
    },
    {
      "start": 16.94,
      "end": 19.22,
      "text": "And said a home can break in two",
      "uncertain": false
    },
    {
      "start": 19.22,
      "end": 22.6,
      "text": "At our table every silence had a border",
      "uncertain": false
    },
    {
      "start": 22.6,
      "end": 25.44,
      "text": "Every photograph could start a fight",
      "uncertain": false
    },
    {
      "start": 26.14,
      "end": 29.42,
      "text": "I learned to hold two histories in my chest",
      "uncertain": false
    },
    {
      "start": 29.42,
      "end": 31.5,
      "text": "And wake up tired in the night",
      "uncertain": true
    },
    {
      "start": 32.98,
      "end": 36.28,
      "text": "I heard the sirens through a cousin's phone",
      "uncertain": false
    },
    {
      "start": 36.28,
      "end": 39.52,
      "text": "I saw the checkpoint lines on a screen",
      "uncertain": false
    },
    {
      "start": 40.56,
      "end": 44.06,
      "text": "One child counting seconds in a shelter",
      "uncertain": false
    },
    {
      "start": 44.06,
      "end": 47.8,
      "text": "One child asking where his street had been",
      "uncertain": false
    },
    {
      "start": 49.8,
      "end": 53.44,
      "text": "I am not half of anybody's sorrow",
      "uncertain": false
    },
    {
      "start": 53.44,
      "end": 56.32,
      "text": "I am not a flag they make me choose",
      "uncertain": false
    },
    {
      "start": 56.32,
      "end": 59.5,
      "text": "I carry Hebrew prayers and Arabic mourning",
      "uncertain": true
    },
    {
      "start": 59.5,
      "end": 62.36,
      "text": "I carry all the names we cannot lose",
      "uncertain": false
    },
    {
      "start": 62.36,
      "end": 65.74,
      "text": "If love is brave enough to hear the other",
      "uncertain": false
    },
    {
      "start": 65.74,
      "end": 68.42,
      "text": "Then let it start with me tonight",
      "uncertain": false
    },
    {
      "start": 68.42,
      "end": 71.08,
      "text": "Two names at the table",
      "uncertain": false
    },
    {
      "start": 71.08,
      "end": 73.62,
      "text": "One heart still beating",
      "uncertain": false
    },
    {
      "start": 75.46,
      "end": 77.96,
      "text": "Trying to make a little laugh",
      "uncertain": false
    },
    {
      "start": 79.14,
      "end": 83.32,
      "text": "My aunt remembers buses smoking, shouting",
      "uncertain": false
    },
    {
      "start": 83.32,
      "end": 87.26,
      "text": "My uncle mourns an olive grove gone there",
      "uncertain": true
    },
    {
      "start": 87.26,
      "end": 91.76,
      "text": "They hand me grief like something I must guard",
      "uncertain": false
    },
    {
      "start": 91.76,
      "end": 94.66,
      "text": "As if grief were the only thing to share",
      "uncertain": false
    },
    {
      "start": 94.66,
      "end": 97.92,
      "text": "There are hostages who should come home living",
      "uncertain": false
    },
    {
      "start": 97.92,
      "end": 101.16,
      "text": "There are families beneath collapsed stone",
      "uncertain": false
    },
    {
      "start": 102.0,
      "end": 105.34,
      "text": "There are children taught to fear a language",
      "uncertain": false
    },
    {
      "start": 105.34,
      "end": 107.68,
      "text": "Before they ever speak their own",
      "uncertain": false
    },
    {
      "start": 108.7,
      "end": 112.52,
      "text": "I will not make a weapon of my blood",
      "uncertain": false
    },
    {
      "start": 112.52,
      "end": 115.62,
      "text": "I will not call compassion a betrayal",
      "uncertain": false
    },
    {
      "start": 115.62,
      "end": 120.28,
      "text": "I'll say the dead deserve their names in mourning",
      "uncertain": false
    },
    {
      "start": 120.28,
      "end": 125.14,
      "text": "I'll say no mother's tears are less than real",
      "uncertain": false
    },
    {
      "start": 127.46,
      "end": 131.22,
      "text": "I am not half of anybody's sorrow",
      "uncertain": false
    },
    {
      "start": 131.22,
      "end": 134.7,
      "text": "I am the bridge my family never knew",
      "uncertain": false
    },
    {
      "start": 134.7,
      "end": 138.8,
      "text": "I'll keep the candles, keep the keys, keep listening",
      "uncertain": false
    },
    {
      "start": 138.8,
      "end": 141.72,
      "text": "Till fear gives way to something true",
      "uncertain": true
    },
    {
      "start": 141.72,
      "end": 146.0,
      "text": "And when they ask me where my heart belongs now",
      "uncertain": false
    },
    {
      "start": 146.0,
      "end": 148.6,
      "text": "I'll answer here with all of you",
      "uncertain": false
    },
    {
      "start": 148.6,
      "end": 152.62,
      "text": "Two names at the table, one heart still beating",
      "uncertain": false
    },
    {
      "start": 152.62,
      "end": 154.78,
      "text": "Making a little lie",
      "uncertain": false
    },
    {
      "start": 155.74,
      "end": 157.3,
      "text": "A little lie",
      "uncertain": false
    }
  ]
}
