      "uncertain": false
    },
    {
      "start": 92.44,
      "end": 96.96,
      "text": "At the diner counter, the arguments rose",
      "uncertain": true
    },
    {
      "start": 96.96,
      "end": 101.54,
      "text": "One wanted more order, one wanted open rows",
      "uncertain": true
    },
    {
      "start": 101.54,
      "end": 105.72,
      "text": "One said the courts were changing overnight",
      "uncertain": false
    },
    {
      "start": 105.72,
      "end": 110.12,
      "text": "One said the kids deserved a safer lie",
      "uncertain": false
    },
    {
      "start": 110.12,
      "end": 114.76,
      "text": "Tony held his coffee, let the whole room spin",
      "uncertain": true
    },
    {
      "start": 114.76,
      "end": 118.6,
      "text": "Said a country breaks when we quit listening",
      "uncertain": false
    },
    {
      "start": 118.6,
      "end": 123.46,
      "text": "I want honest ballots, I want every voice",
      "uncertain": false
    },
    {
      "start": 123.46,
      "end": 128.36,
      "text": "I want families heard, I want a careful choice",
      "uncertain": false
    },
    {
      "start": 130.56,
      "end": 134.62,
      "text": "Strange neighborhood, don't tell me what to see",
      "uncertain": false
    },
    {
      "start": 134.62,
      "end": 138.68,
      "text": "I speak my mind and leave some room to disagree",
      "uncertain": false
    },
    {
      "start": 138.68,
      "end": 143.58,
      "text": "Strange neighborhood, the signs are bane and loud",
      "uncertain": true
    },
    {
      "start": 143.58,
      "end": 148.64,
      "text": "I won't trade my conscience just to blend into the crowd",
      "uncertain": false
    },
    {
      "start": 161.2,
      "end": 165.74,
      "text": "No scapegoats in my song, no strangers to condemn",
      "uncertain": false
    },
    {
