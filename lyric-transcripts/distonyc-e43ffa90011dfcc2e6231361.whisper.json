    {
      "start": 135.2,
      "end": 141.86,
      "text": "If loving you means I'm damned tonight, save me a seat by the firelight.",
      "uncertain": false
    },
    {
      "start": 141.86,
      "end": 149.04,
      "text": "Was I made to fear every hungry spark? Would grace really leave me alone in the dark?",
      "uncertain": false
    },
    {
      "start": 149.3,
      "end": 156.14,
      "text": "Maybe love wears strange cologne, maybe mercy talks in a wandering tone.",
      "uncertain": false
    },
    {
      "start": 157.58,
      "end": 164.5,
