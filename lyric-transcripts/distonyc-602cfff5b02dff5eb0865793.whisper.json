    {
      "start": 6.1,
      "end": 10.14,
      "text": "A neighbor said the whole town's moving fast",
      "uncertain": true
    },
    {
      "start": 10.14,
      "end": 14.74,
      "text": "Like every green light's built to make you last",
      "uncertain": false
    },
    {
      "start": 14.74,
      "end": 19.26,
      "text": "I had a map with coffee on the page",
      "uncertain": false
    },
    {
