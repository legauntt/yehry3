      "text": "Mac got 9-11",
      "uncertain": false
    },
    {
      "start": 40.98,
      "end": 44.66,
      "text": "And the radio hissed beside the dead",
      "uncertain": true
    },
    {
      "start": 48.26,
      "end": 51.0,
      "text": "Ellis watched the river crossing",
      "uncertain": false
    },
    {
      "start": 51.0,
      "end": 54.06,
      "text": "Counting helmets through his sight",
      "uncertain": false
    },
    {
