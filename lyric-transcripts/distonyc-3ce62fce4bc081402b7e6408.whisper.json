      "text": "Matt carried the radio pill",
      "uncertain": false
    },
    {
      "start": 21.02,
      "end": 23.74,
      "text": "Calling thunder through the rain",
      "uncertain": false
    },
    {
      "start": 23.74,
      "end": 27.96,
      "text": "A mortar found the rooftop aerial",
      "uncertain": false
    },
    {
