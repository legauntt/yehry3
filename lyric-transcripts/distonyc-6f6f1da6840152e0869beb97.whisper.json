    {
      "start": 6.46,
      "end": 14.52,
      "text": "By the harbored lamps where the rain comes down, I heard a fiddle wake the town.",
      "uncertain": false
    },
    {
      "start": 14.92,
      "end": 22.36,
      "text": "A weathered coat and a lifted glass for every friend and every pass.",
      "uncertain": false
    },
    {
      "start": 22.62,
      "end": 29.8,
      "text": "The old doors swung, the floorboards rang, a hundred voices nearly sang.",
      "uncertain": true
    },
    {
      "start": 30.0,
      "end": 33.76,
      "text": "Not borrowed words, but a welcome sound",
      "uncertain": false
    },
    {
      "start": 33.76,
      "end": 37.58,
      "text": "From distant hills to this harbor town",
      "uncertain": true
    },
    {
      "start": 38.32,
      "end": 41.62,
      "text": "Raise the window, let the cold wind in",
      "uncertain": false
    },
    {
      "start": 41.62,
      "end": 45.3,
      "text": "Let the night begin again",
      "uncertain": false
    },
    {
      "start": 46.14,
      "end": 48.7,
      "text": "Here's a glass to the green shore",
      "uncertain": false
    },
    {
