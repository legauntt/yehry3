{
  "globalHeaders": {
    "X-Robots-Tag": "noindex, nofollow, noarchive",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self' https:; connect-src 'self' https://chairlift.fly.dev wss://chairlift.fly.dev; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
  },
  "routes": [
    { "route": "/aci", "redirect": "/aci/", "statusCode": 301 },
    { "route": "/aci/*", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/sausage", "redirect": "/sausage/", "statusCode": 301 },
    { "route": "/sausage/*", "headers": { "Cache-Control": "no-cache" } },
    {
      "route": "/mixtapes",
      "redirect": "/mixtapes/",
      "statusCode": 301
    },
    {
      "route": "/mixtapes/*",
      "rewrite": "/mixtapes/index.html",
      "headers": { "Cache-Control": "no-cache" }
    },
    {
      "route": "/fearop",
      "redirect": "https://chairlift.fly.dev/yehry3/fearop/",
      "statusCode": 302,
      "headers": { "Cache-Control": "no-store", "Referrer-Policy": "no-referrer" }
    },
    {
      "route": "/fearop/*",
      "redirect": "https://chairlift.fly.dev/yehry3/fearop/",
      "statusCode": 302,
      "headers": { "Cache-Control": "no-store", "Referrer-Policy": "no-referrer" }
    },
    {
      "route": "/songs/*",
      "headers": { "Cache-Control": "no-cache" }
    },
    {
      "route": "/catalog-summary.json",
      "headers": { "Cache-Control": "no-cache" }
    },
    {
      "route": "/deployment.json",
      "headers": { "Cache-Control": "no-store" }
    },
    {
      "route": "/arabic",
      "redirect": "/arabic/",
      "statusCode": 302
    },
    {
      "route": "/arabic/*",
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/audtism",
      "redirect": "/audtism/",
      "statusCode": 302
    },
    {
      "route": "/timeline",
      "redirect": "/timeline/",
      "statusCode": 302
    },
    {
      "route": "/oeuful",
      "redirect": "/oeuful/",
      "statusCode": 302
    },
    {
      "route": "/oeuful/*",
      "headers": { "Cache-Control": "no-cache" }
    },
    {
      "route": "/v9",
      "redirect": "/v9/epochs/",
      "statusCode": 302
    },
    {
      "route": "/v9/epochs",
      "redirect": "/v9/epochs/",
      "statusCode": 302
    },
    {
      "route": "/v9/epochs/*",
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/deetz",
      "redirect": "/deetz/",
      "statusCode": 301
    },
    {
      "route": "/deetz/*",
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/original-prompt",
      "redirect": "/original-prompt/",
      "statusCode": 301
    },
    {
      "route": "/fearhunger",
      "redirect": "/fearhunger/",
      "statusCode": 301
    },
    {
      "route": "/lyrics",
      "redirect": "/lyrics/",
      "statusCode": 301
    },
    {
      "route": "/lyrics/*",
      "rewrite": "/lyrics/index.html",
      "headers": { "Cache-Control": "no-cache" }
    },
    {
      "route": "/distonyc",
      "redirect": "/distonyc/",
      "statusCode": 301
    },
    {
      "route": "/longtimecomin*",
      "redirect": "/distonyc/",
      "statusCode": 301
    },
    {
      "route": "/admin",
      "redirect": "/admin/",
      "statusCode": 301
    },
    {
      "route": "/admin/*",
      "rewrite": "/admin/index.html",
      "headers": { "Cache-Control": "no-cache" }
    },
    {
      "route": "/catalog.json",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/basis-songs.json",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/fearhunger/fearhunger.js",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/fearhunger/fearhunger.css",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/wiseau",
      "redirect": "/wiseau/",
      "statusCode": 301
    },
    {
      "route": "/wiseau/clips.json",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/wiseau/wiseau.js",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/wiseau/wiseau.css",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/wiseau/clips/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/queue",
      "redirect": "/queue/",
      "statusCode": 301
    },
    {
      "route": "/notifications-sw.js",
      "headers": {
        "Cache-Control": "no-cache"
      }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  },
  "mimeTypes": {
    ".mp3": "audio/mpeg"
  }
}
